# اختيار نسخة جافا المناسبة للمشروع (استخدمنا نسخة 17 كمثال، لو مشروعك غيرها ممكن تعدلها)
FROM eclipse-temurin:21-jdk-alpine

# إنشاء مجلد مؤقت داخل الحاوية لتخزين الملفات المؤقتة
VOLUME /tmp

# نسخ ملف الـ Jar اللي بينتج بعد البناء (Build) إلى داخل الحاوية ويسمى app.jar
COPY target/*.jar app.jar

# أمر تشغيل التطبيق أول ما الحاوية تشتغل
ENTRYPOINT ["java","-jar","/app.jar"]